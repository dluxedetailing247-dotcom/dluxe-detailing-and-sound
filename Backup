<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <meta name="theme-color" content="#090b10">
  <meta name="description" content="D-LUXE DETAILING & SOUND Business Platform">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="D-LUXE">

  <link rel="manifest" href="./manifest.json">

  <title>D-LUXE DETAILING & SOUND</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #090b10;
      color: #ffffff;
      font-family: Arial, sans-serif;
    }

    header {
      padding: 17px;
      background: #151922;
      position: sticky;
      top: 0;
      z-index: 10;
      border-bottom: 1px solid #30394a;
    }

    h1 {
      margin: 0;
      font-size: 20px;
    }

    .tag {
      color: #f5b700;
      font-size: 11px;
      font-weight: bold;
      margin-top: 4px;
    }

    nav {
      padding: 10px;
      background: #0d1119;
      display: flex;
      gap: 7px;
      overflow-x: auto;
    }

    button {
      padding: 10px 13px;
      border: 0;
      border-radius: 10px;
      background: #273043;
      color: #ffffff;
      font-weight: bold;
      cursor: pointer;
    }

    .primary,
    .install {
      background: #f5b700;
      color: #111111;
    }

    .install {
      margin-top: 10px;
    }

    main {
      max-width: 1050px;
      margin: auto;
      padding: 16px;
    }

    .page {
      display: none;
    }

    .page.active {
      display: block;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 15px;
    }

    .card {
      background: #151922;
      border: 1px solid #30394a;
      border-radius: 16px;
      padding: 16px;
    }

    .out,
    .item {
      background: #0b0f16;
      padding: 12px;
      border-radius: 10px;
      margin-top: 10px;
      white-space: pre-line;
      overflow-wrap: break-word;
    }

    label {
      display: block;
      color: #aab3c3;
      font-size: 12px;
      margin: 10px 0 5px;
    }

    input,
    select {
      width: 100%;
      padding: 11px;
      background: #0b0f16;
      color: #ffffff;
      border: 1px solid #394354;
      border-radius: 9px;
    }

    .small {
      font-size: 12px;
      color: #aab3c3;
    }

    .status {
      color: #3ddc97;
      font-size: 12px;
    }

    .error {
      color: #ff7777;
    }

    #installAppBtn[hidden] {
      display: none;
    }
  </style>
</head>

<body>

<header>
  <h1>D-LUXE DETAILING & SOUND</h1>
  <div class="tag">DETAIL • SOUND • STANCE CULTURE 🇿🇦</div>
</header>

<nav>
  <button onclick="showPage('home')">🏠 Dashboard</button>
  <button onclick="showPage('requests')">📨 Requests</button>
  <button onclick="showPage('tools')">🔧 Tools</button>
  <button onclick="showPage('settings')">⚙ Settings</button>
</nav>

<main>

  <!-- HOME -->
  <section id="home" class="page active">
    <div class="grid">

      <div class="card">
        <h2>Business Dashboard</h2>
        <p id="connection" class="status">Starting D-LUXE...</p>
        <div id="summary" class="out">Loading services...</div>

        <button class="primary" onclick="showPage('requests')">
          View client requests
        </button>
      </div>

      <div class="card">
        <h3>📱 D-LUXE Mobile App</h3>

        <p class="small">
          Install D-LUXE for a standalone app experience.
        </p>

        <button id="installAppBtn" class="install" hidden>
          📲 Install D-LUXE App
        </button>

        <p id="installStatus" class="small">
          Checking installation availability...
        </p>
      </div>

    </div>
  </section>

  <!-- REQUESTS -->
  <section id="requests" class="page">
    <div class="grid">

      <div class="card">
        <h2>Live Client Requests</h2>

        <button class="primary" onclick="loadRequests()">
          ↻ Refresh
        </button>

        <div id="requestList" class="out">
          Open this page to load requests.
        </div>
      </div>

      <div class="card">
        <h2>Details</h2>

        <div id="requestDetail" class="out">
          Select a request.
        </div>
      </div>

    </div>
  </section>

  <!-- TOOLS -->
  <section id="tools" class="page">
    <div class="grid">

      <div class="card">
        <h2>Custom Box Wizard</h2>

        <label>Subwoofer model *</label>
        <input id="subModel" placeholder="Enter subwoofer model">

        <label>Verified manufacturer net volume (L) *</label>
        <input id="boxVol" type="number" step="0.1">

        <label>Verified manufacturer tuning (Hz) *</label>
        <input id="boxTune" type="number">

        <label>Build goal</label>
        <select id="goal">
          <option>Hard-hitting daily bass</option>
          <option>Deep low bass daily</option>
          <option>Clean musical bass</option>
          <option>Stance/show build</option>
        </select>

        <br><br>

        <button class="primary" onclick="boxPlan()">
          Create planning brief
        </button>

        <div id="boxResult" class="out"></div>
      </div>

      <div class="card">
        <h2>Amplifier Voltage Target</h2>

        <label>Target RMS power</label>
        <input id="rms" type="number" value="500">

        <label>Final impedance (Ω)</label>
        <input id="ohms" type="number" value="2" step="0.1">

        <br><br>

        <button class="primary" onclick="voltage()">
          Calculate
        </button>

        <div id="voltResult" class="out"></div>
      </div>

    </div>
  </section>

  <!-- SETTINGS -->
  <section id="settings" class="page">
    <div class="grid">

      <div class="card">
        <h2>Supabase Connection</h2>

        <p id="settingsConnection" class="status">
          Starting connection...
        </p>

        <h3>Admin Login</h3>

        <label>Email</label>
        <input id="loginEmail" type="email">

        <label>Password</label>
        <input id="loginPassword" type="password">

        <br><br>

        <button class="primary" onclick="login()">
          Log in
        </button>

        <button onclick="logout()">
          Log out
        </button>

        <p id="authStatus" class="small"></p>
      </div>

      <div class="card">
        <h2>Security</h2>
        <p class="small">
          Admin access is controlled through Supabase Authentication
          and your database security policies.
        </p>
      </div>

    </div>
  </section>

</main>

<!-- SUPABASE -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script>
"use strict";

/* =========================
   GLOBAL VARIABLES
========================= */

let sb = null;
let currentRequests = [];
let deferredInstallPrompt = null;


/* =========================
   PAGE NAVIGATION
========================= */

function showPage(id) {
  document.querySelectorAll(".page").forEach(page => {
    page.classList.remove("active");
  });

  const page = document.getElementById(id);

  if (page) {
    page.classList.add("active");
  }

  if (id === "requests") {
    loadRequests();
  }
}


/* =========================
   SUPABASE
========================= */

async function initSupabase() {
  const connection = document.getElementById("connection");
  const settingsConnection = document.getElementById("settingsConnection");
  const summary = document.getElementById("summary");

  try {
    connection.textContent = "Loading Supabase configuration...";
    settingsConnection.textContent = "Loading Supabase configuration...";
    summary.textContent = "Connecting D-LUXE services...";

    if (!window.supabase) {
      throw new Error("Supabase library did not load.");
    }

    const response = await fetch("./public-config.json?version=1", {
      cache: "no-store"
    });

    if (!response.ok) {
      throw new Error(
        "Could not load public-config.json. Status: " +
        response.status
      );
    }

    const config = await response.json();

    if (!config.supabaseUrl) {
      throw new Error("Supabase URL is missing.");
    }

    if (!config.supabaseAnonKey) {
      throw new Error("Supabase publishable key is missing.");
    }

    sb = window.supabase.createClient(
      config.supabaseUrl,
      config.supabaseAnonKey
    );

    connection.textContent = "● Supabase configured";
    settingsConnection.textContent = "● Supabase configured";
    summary.textContent = "D-LUXE is connected and ready.";

    await checkAuth();

  } catch (error) {
    console.error("Supabase error:", error);

    connection.textContent =
      "● Connection error: " + error.message;

    connection.classList.add("error");

    settingsConnection.textContent =
      "● Connection error: " + error.message;

    settingsConnection.classList.add("error");

    summary.textContent =
      "D-LUXE could not connect: " + error.message;
  }
}


/* =========================
   AUTHENTICATION
========================= */

async function checkAuth() {
  if (!sb) return;

  try {
    const result = await sb.auth.getSession();

    document.getElementById("authStatus").textContent =
      result.data.session
        ? "● Admin logged in"
        : "● Admin login required";

  } catch (error) {
    document.getElementById("authStatus").textContent =
      "Auth error: " + error.message;
  }
}


async function login() {
  if (!sb) {
    document.getElementById("authStatus").textContent =
      "Supabase is not connected.";
    return;
  }

  const email =
    document.getElementById("loginEmail").value.trim();

  const password =
    document.getElementById("loginPassword").value;

  if (!email || !password) {
    document.getElementById("authStatus").textContent =
      "Enter your email and password.";
    return;
  }

  try {
    const result =
      await sb.auth.signInWithPassword({
        email,
        password
      });

    if (result.error) {
      throw result.error;
    }

    document.getElementById("authStatus").textContent =
      "Logged in successfully.";

    await checkAuth();

  } catch (error) {
    document.getElementById("authStatus").textContent =
      "Login error: " + error.message;
  }
}


async function logout() {
  if (!sb) return;

  try {
    await sb.auth.signOut();

    document.getElementById("authStatus").textContent =
      "Logged out.";

  } catch (error) {
    document.getElementById("authStatus").textContent =
      "Logout error: " + error.message;
  }
}


/* =========================
   CLIENT REQUESTS
========================= */

async function loadRequests() {
  const requestList =
    document.getElementById("requestList");

  if (!sb) {
    requestList.textContent =
      "Supabase is not connected yet.";
    return;
  }

  requestList.textContent =
    "Loading requests...";

  try {
    const result =
      await sb
        .from("service_requests")
        .select("*")
        .order("created_at", {
          ascending: false
        });

    if (result.error) {
      throw result.error;
    }

    currentRequests = result.data || [];

    if (!currentRequests.length) {
      requestList.textContent =
        "No requests yet.";
      return;
    }

    requestList.innerHTML =
      currentRequests.map((request, index) => `
        <div class="item">
          <b>${escapeHtml(request.client_name)}</b>
          — ${escapeHtml(request.service)}
          <br>
          <span class="small">
            ${escapeHtml(
              request.vehicle || "Vehicle not supplied"
            )}
          </span>
          <br><br>
          <button onclick="viewRequest(${index})">
            View details
          </button>
        </div>
      `).join("");

  } catch (error) {
    requestList.textContent =
      "Unable to load requests: " +
      error.message;
  }
}


function viewRequest(index) {
  const request = currentRequests[index];

  if (!request) return;

  document.getElementById("requestDetail").textContent =
    "CLIENT: " + (request.client_name || "-") +
    "\nPHONE: " + (request.phone || "-") +
    "\nVEHICLE: " + (request.vehicle || "-") +
    "\nSERVICE: " + (request.service || "-") +
    "\nSTATUS: " + (request.status || "New") +
    "\n\nREQUEST:\n" +
    (request.request_details || "-");
}


function escapeHtml(value) {
  return String(value || "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}


/* =========================
   BOX PLANNER
========================= */

function boxPlan() {
  const model =
    document.getElementById("subModel").value.trim();

  const volume =
    Number(document.getElementById("boxVol").value);

  const tuning =
    Number(document.getElementById("boxTune").value);

  if (!model || volume <= 0 || tuning <= 0) {
    document.getElementById("boxResult").textContent =
      "Enter verified subwoofer specifications first.";
    return;
  }

  document.getElementById("boxResult").textContent =
    "CUSTOM BOX PLANNING BRIEF\n\n" +
    "Subwoofer: " + model +
    "\nNet volume: " + volume + " L" +
    "\nTuning: " + tuning + " Hz" +
    "\nGoal: " +
    document.getElementById("goal").value +
    "\n\nVerify vehicle space, driver displacement and port requirements before construction.";
}


/* =========================
   VOLTAGE CALCULATOR
========================= */

function voltage() {
  const power =
    Number(document.getElementById("rms").value);

  const impedance =
    Number(document.getElementById("ohms").value);

  if (power <= 0 || impedance <= 0) {
    document.getElementById("voltResult").textContent =
      "Enter valid RMS power and impedance.";
    return;
  }

  const target =
    Math.sqrt(power * impedance);

  document.getElementById("voltResult").textContent =
    "Starting voltage target: " +
    target.toFixed(1) +
    " V AC\n\n" +
    "Use suitable measurement equipment and a clean test signal.";
}


/* =========================
   PWA INSTALLATION
========================= */

const installButton =
  document.getElementById("installAppBtn");

const installStatus =
  document.getElementById("installStatus");


window.addEventListener(
  "beforeinstallprompt",
  event => {
    event.preventDefault();

    deferredInstallPrompt = event;

    installButton.hidden = false;

    installStatus.textContent =
      "D-LUXE is ready to install. Tap the Install button.";
  }
);


installButton.addEventListener(
  "click",
  async () => {

    if (!deferredInstallPrompt) {
      installStatus.textContent =
        "Installation is not available yet. Try Chrome's menu.";
      return;
    }

    try {
      deferredInstallPrompt.prompt();

      const choice =
        await deferredInstallPrompt.userChoice;

      if (choice.outcome === "accepted") {
        installStatus.textContent =
          "Installing D-LUXE...";
      } else {
        installStatus.textContent =
          "Installation was cancelled.";
      }

      deferredInstallPrompt = null;
      installButton.hidden = true;

    } catch (error) {
      console.error("Install error:", error);

      installStatus.textContent =
        "Install error: " + error.message;
    }
  }
);


window.addEventListener(
  "appinstalled",
  () => {
    installStatus.textContent =
      "D-LUXE installed successfully!";

    installButton.hidden = true;
    deferredInstallPrompt = null;
  }
);


/* =========================
   SERVICE WORKER
========================= */

if ("serviceWorker" in navigator) {
  window.addEventListener(
    "load",
    () => {
      navigator.serviceWorker
        .register("./service-worker.js")
        .then(registration => {
          console.log(
            "D-LUXE service worker registered:",
            registration.scope
          );
        })
        .catch(error => {
          console.error(
            "Service worker registration failed:",
            error
          );
        });
    }
  );
}


/* =========================
   START APPLICATION
========================= */

document.addEventListener(
  "DOMContentLoaded",
  async () => {
    await initSupabase();

    if (!deferredInstallPrompt) {
      installStatus.textContent =
        "Checking whether your browser supports installation...";
    }
  }
);

</script>

</body>
</html>
